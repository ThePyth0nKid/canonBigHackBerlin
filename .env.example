# Canon — environment example
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.

# ---------------------------------------------------------------------------
# Database — Postgres (Railway recommended; any Postgres works)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://USER:PASS@HOST:PORT/DB"

# ---------------------------------------------------------------------------
# Auth.js v5
# ---------------------------------------------------------------------------
AUTH_SECRET="run: openssl rand -base64 32"
# In dev: http://localhost:3000 ; in prod: your public origin
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# GitHub OAuth — github.com/settings/developers
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Google OAuth — console.cloud.google.com/apis/credentials
# Required scopes for Gmail ingestion: openid email profile + gmail.readonly
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ---------------------------------------------------------------------------
# Layer 1 — Pioneer / Fastino GLiNER-2 (deterministic span extraction)
# Sign up: https://gliner.pioneer.ai/  (Big Berlin Hack onboarding page in Notion)
# ---------------------------------------------------------------------------
PIONEER_API_KEY="pio_sk_..."

# ---------------------------------------------------------------------------
# Layer 2 — Google Cloud / Vertex AI / Gemini 2.5-flash (long-context auditor)
# In dev we use ADC (`gcloud auth application-default login`).
# In prod set GOOGLE_APPLICATION_CREDENTIALS to a service-account JSON path
# OR run on an environment with workload identity attached.
# ---------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="europe-west4"

# ---------------------------------------------------------------------------
# Layer 2.5 — Tavily (external web context, returned UNSIGNED)
# Sign up: https://app.tavily.com/  (1k free credits; bonus code TVLY-DLEE5IJU)
# ---------------------------------------------------------------------------
TAVILY_API_KEY="tvly-..."

# ---------------------------------------------------------------------------
# Layer 3 — Aikido Security (recursive trust: scans Canon's own repo)
# Sign up: https://app.aikido.dev/  (Pro trial automatic for hackathon)
# ---------------------------------------------------------------------------
AIKIDO_CLIENT_ID="AIK_CLIENT_..."
AIKIDO_CLIENT_SECRET="AIK_SECRET_..."

# ---------------------------------------------------------------------------
# Source adapters
# ---------------------------------------------------------------------------
# Slack user-token (xoxp-...) for conversations.history on the demo channel
SLACK_USER_TOKEN="xoxp-..."
SLACK_SIGNING_SECRET=""
SLACK_DEMO_CHANNEL="C0B058UN0PK"  # override to point at your own channel

# ---------------------------------------------------------------------------
# Optional — Anthropic (not in pipeline today; reserved for future agent flows)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_API_KEY_BACKUP=""

# ---------------------------------------------------------------------------
# Layer 4 — canon-signer / canon-verify Rust binaries
# Build from `empheral` workspace; for path-portability in dev:
# ---------------------------------------------------------------------------
CANON_SIGNER_PATH="/absolute/path/to/canon-signer"
CANON_VERIFY_PATH="/absolute/path/to/canon-verify"
